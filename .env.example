# Copia este archivo a ".env" y ajusta segun tu entorno.
#
# ── MODO LOCAL (tu PC con SQL Server Express + autenticacion de Windows) ──
# Deja DB_USER y DB_PASSWORD vacios/sin definir para usar este modo.
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=InventarioConstruccion
DB_DRIVER=ODBC Driver 17 for SQL Server

# ── MODO NUBE (Azure SQL + Vercel) ──
# Define estas 4 variables (en el dashboard de Vercel, NUNCA en este repo)
# para que la app use pymssql con autenticacion SQL en vez de Windows:
# DB_SERVER=tu-servidor.database.windows.net
# DB_PORT=1433
# DB_NAME=InventarioConstruccion
# DB_USER=tu_usuario
# DB_PASSWORD=tu_contrasena

SECRET_KEY=cambia-esta-clave-en-produccion
FLASK_DEBUG=true

# Origen(es) permitidos para llamar a la API (el frontend en desarrollo con Vite)
CORS_ORIGINS=http://localhost:5173
